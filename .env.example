# Copy to .env for local use. Submit your filled .env only through the Google Form — do not commit .env.

# --- EMG live demo: Tuya smart plug or bulb (local LAN) ---
# Use the SAME device id + local_key + IP together (from one Tuya IoT export).
# tinytuya Err 914 = mismatch; run test_tuya_plug.py until status/turn_on work, then paste here.
TUYA_DEVICE_ID=
TUYA_LOCAL_KEY=
# Private LAN IP of the plug (router DHCP list), not the "ip" from Tuya Cloud API.
TUYA_IP=
TUYA_VERSION=3.4
# Optional: faster fail when IP is wrong (test_tuya_plug.py)
# TUYA_CONNECT_TIMEOUT=4
# TUYA_CONNECT_RETRIES=2
# outlet (default) or bulb — bulbs use BulbDevice + auto switch DP when type=bulb
TUYA_DEVICE_TYPE=outlet
# Many Wi‑Fi plugs/switches use 1; many bulbs use 20. Ignored when TUYA_DEVICE_TYPE=bulb (auto).
TUYA_SWITCH_DPS=1
# Optional: persistent TCP (try if commands look OK but light does not change)
# TUYA_PERSIST=1
# Optional: seconds to wait after send before read (e.g. 0.15)
# TUYA_SEND_WAIT=0.15
# Optional: print full dps after each command
# TUYA_VERBOSE=1

# --- Optional: EMG live demo cloud fallback ---
IFTTT_KEY=
IFTTT_EVENT_ON=neuro_shift_on
IFTTT_EVENT_OFF=neuro_shift_off

# --- Optional: override paths without editing emg_config.json ---
# EMG_SERIAL_PORT=COM4
# EMG_MODEL_PATH=emg_rf_model.pkl
